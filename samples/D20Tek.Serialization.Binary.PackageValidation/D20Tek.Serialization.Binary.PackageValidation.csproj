<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="D20Tek.Serialization.Binary" Version="0.10.4" />
    <PackageReference Include="D20Tek.Serialization.Core" Version="0.10.4" />

    <!-- Direct pins override vulnerable transitive dependencies from the published packages. -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <!-- Reference the PUBLISHED NuGet packages, not project references.
       The local nuget.config points at ../../nupkgs as a package source. -->

</Project>
