<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="D20Tek.Serialization.Binary" Version="0.10.2" />
    <PackageReference Include="D20Tek.Serialization.Core" Version="0.10.2" />
  </ItemGroup>

  <!-- Reference the PUBLISHED NuGet packages, not project references.
       The local nuget.config points at ../../nupkgs as a package source. -->

</Project>
